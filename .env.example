# Local development defaults.
APP_MODE=dev
HOST=127.0.0.1
PORT=5173

# Optional path overrides.
# CLAUDE_HOME=/home/agent/.claude
# CODEX_HOME=/home/agent/.codex
# DOUJIE_HOME=/home/agent/.doujie
# SESSION_DATA_DIR=./data
# SESSION_SOURCE=local-index
# SESSION_LOCAL_MACHINE_ID=server
# SESSION_LOCAL_MACHINE_LABEL=Server

# Required in production mode.
# SESSION_ACCESS_TOKEN=replace-with-a-long-random-token

# Required only when accepting outbound pushes from another machine.
# SESSION_PUSH_TOKENS=macbook:replace-with-a-different-long-random-token

# Mac-side pusher example. Keep these in a local untracked env file.
# SESSION_PUSH_URL=https://session-insight.example.com
# SESSION_PUSH_TOKEN=replace-with-the-macbook-token
# SESSION_PUSH_MACHINE_ID=macbook
# SESSION_PUSH_MACHINE_LABEL=MacBook
# SESSION_PUSH_PROVIDERS=codex,claude,doujie
